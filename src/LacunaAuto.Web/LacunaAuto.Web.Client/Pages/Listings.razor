@page "/listings"
@using LacunaAuto.UI.Shared.Components
@using LacunaAuto.Web.Client.Services
@using Microsoft.Extensions.Localization
@using System.Text.Json
@inject IStringLocalizer<LacunaAuto.UI.Shared.Resources.SharedResources> Localizer
@inject NavigationManager Navigation
@inject IPublicListingsService ListingsService

<PageTitle>@Localizer["Search"] - Lacuna Auto</PageTitle>

<div class="listings-page">
    <header class="page-header">
        <button class="back-button" type="button" aria-label="@Localizer["Home"]" @onclick="NavigateBack">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.5 5L7.5 12L14.5 19" />
            </svg>
        </button>
        <div class="header-info">
            <span class="result-count">@_listings.Count @Localizer["Results"]</span>
            <span class="sort-label">@Localizer["Newest"]</span>
        </div>
        <button class="filter-button" type="button" aria-label="@Localizer["Filter"]" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 7h16M7 12h10M10 17h4" />
                <circle cx="8" cy="7" r="1.5" />
                <circle cx="16" cy="12" r="1.5" />
                <circle cx="12" cy="17" r="1.5" />
            </svg>
        </button>
    </header>

    <div class="listings-content">
        @if (_isLoading)
        {
            <div class="empty-state" data-lacuna-loading="true">
                <p>@Localizer["Loading"]</p>
            </div>
        }
        else if (_hasLoadingError)
        {
            <div class="empty-state">
                <p>@Localizer["ErrorLoadingContent"]</p>
            </div>
        }
        else if (_listings.Count == 0)
        {
            <div class="empty-state">
                <p>@Localizer["NoResultsFound"]</p>
                <a href="/" class="clear-link">@Localizer["ClearFilters"]</a>
            </div>
        }
        else
        {
            @foreach (var listing in _listings)
            {
                <VehicleListingCard Model="listing" OnClick="() => NavigateToDetails(listing.Id)" />
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<VehicleListingCardModel> _listings = Array.Empty<VehicleListingCardModel>();
    private bool _isLoading = true;
    private bool _hasLoadingError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _listings = await ListingsService.GetAllAsync();
        }
        catch (HttpRequestException)
        {
            _hasLoadingError = true;
            _listings = Array.Empty<VehicleListingCardModel>();
        }
        catch (TaskCanceledException)
        {
            _hasLoadingError = true;
            _listings = Array.Empty<VehicleListingCardModel>();
        }
        catch (JsonException)
        {
            _hasLoadingError = true;
            _listings = Array.Empty<VehicleListingCardModel>();
        }
        catch (NotSupportedException)
        {
            _hasLoadingError = true;
            _listings = Array.Empty<VehicleListingCardModel>();
        }
        catch (InvalidOperationException)
        {
            _hasLoadingError = true;
            _listings = Array.Empty<VehicleListingCardModel>();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/");
    }

    private void NavigateToDetails(int id)
    {
        Navigation.NavigateTo($"/listings/{id}");
    }
}
