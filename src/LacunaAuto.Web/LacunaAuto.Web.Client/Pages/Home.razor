@page "/"
@using LacunaAuto.UI.Shared.Components
@implements IDisposable
@inject ListingsClient BrowsingApi
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<LacunaAuto.UI.Shared.Resources.SharedResources> Localizer
@inject NavigationManager Navigation

<PageTitle>Lacuna Auto</PageTitle>

<div class="home-page" aria-busy="@(_isLoading ? "true" : "false")">
    <header class="page-header">
        <div class="header-content">
            <h1 class="wordmark">Lacuna</h1>
            <div class="search-bar" @onclick="NavigateToListings">
                <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="5.5" />
                    <path d="M15.5 15.5L20 20" />
                </svg>
                <span class="search-placeholder">@Localizer["Search"]</span>
            </div>
            <button class="filter-button" type="button" aria-label="@Localizer["Filter"]" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 7h16M7 12h10M10 17h4" />
                    <circle cx="8" cy="7" r="1.5" />
                    <circle cx="16" cy="12" r="1.5" />
                    <circle cx="12" cy="17" r="1.5" />
                </svg>
            </button>
        </div>
    </header>

    <div class="categories">
        <button class="category-chip active">@Localizer["AllVehicles"]</button>
        <button class="category-chip" disabled>@Localizer["Electric"]</button>
        <button class="category-chip" disabled>@Localizer["SUVs"]</button>
        <button class="category-chip" disabled>@Localizer["Sports"]</button>
        <button class="category-chip" disabled>@Localizer["Sedans"]</button>
        <button class="category-chip" disabled>@Localizer["Trucks"]</button>
    </div>

    <div class="listings-feed">
        @if (_isLoading)
        {
            <span class="visually-hidden" role="status">@Localizer["Loading"]</span>
            @for (var i = 0; i < 4; i++)
            {
                <SkeletonCard />
            }
        }
        else if (_hasError || _listings.Count == 0)
        {
            <BrowsingFeedback HasError="_hasError" OnRetry="LoadAsync" />
        }
        else
        {
            @foreach (var listing in _listings)
            {
                <VehicleListingCard @key="listing.Id" Model="listing" OnClick="() => NavigateToDetails(listing.Id)" />
            }
        }
    </div>
</div>

@code {
    private IReadOnlyList<VehicleListingCardModel> _listings = Array.Empty<VehicleListingCardModel>();

    private readonly CancellationTokenSource _lifetime = new();
    private bool _isLoading = true;
    private bool _hasError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _hasError = false;
        _listings = Array.Empty<VehicleListingCardModel>();
        try
        {
            _listings = await BrowsingApi.GetListingsAsync(_lifetime.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
        }
        catch (Exception exception) when (exception is HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private void NavigateToListings()
    {
        Navigation.NavigateTo("/listings");
    }

    private void NavigateToDetails(int id)
    {
        Navigation.NavigateTo($"/listings/{id}");
    }
}
